{
  "name": "PiiShooter",
  "version": "1.2.0",
  "description": "Catches personal information in files and text before you upload or paste them into a website.",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PiiShooter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "http://localhost:5173/*"
      ],
      "js": [
        "src/settings.js",
        "src/detectors.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://localhost:5173/*"
      ],
      "js": [
        "src/config.js",
        "src/site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "140"
}
